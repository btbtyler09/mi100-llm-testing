# Required host directories. Override in the shell or a copy outside the checkout.
GLM53_MODEL_DIR=
GLM53_CACHE_DIR=
GLM53_IMAGE=glm53-flash-mi100:local
GLM53_HOST=127.0.0.1
GLM53_PORT=8000
GLM53_RESTART=unless-stopped
GLM53_MAX_MODEL_LEN=-1
GLM53_BATCH_TOKENS=2560
GLM53_MAX_NUM_SEQS=2
GLM53_LONG_PREFILL_TOKEN_THRESHOLD=1280
GLM53_GPU_MEMORY_UTILIZATION=0.95
GLM53_GRAPH_SIZES=[1,2,4]
GLM53_SPECULATIVE_CONFIG={"method":"mtp","num_speculative_tokens":1}
GLM53_GFX908_SINGLE_GROUP=1
GLM53_GFX908_DIRECT_W4=1
GLM53_LINEAR_TOOL_TEMPLATE=1
GLM53_VALIDATE_LOGITS=0
